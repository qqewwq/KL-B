      </CodeComponent>
      <ImageComponent name="obraz" plugin="None">
        <Param name="name" val="obraz" valType="code" updates="None"/>
        <Param name="image" val="$image_file" valType="file" updates="set every repeat"/>
        <Param name="pos" val="(0,0)" valType="list" updates="constant"/>
        <Param name="size" val="$[stim_width, stim_height]" valType="list" updates="set every repeat"/>
        <Param name="anchor" val="center" valType="str" updates="constant"/>
        <Param name="color" val="$[1,1,1]" valType="color" updates="constant"/>
        <Param name="colorSpace" val="rgb" valType="str" updates="constant"/>
        <Param name="contrast" val="1" valType="num" updates="constant"/>
        <Param name="interpolate" val="linear" valType="str" updates="constant"/>
        <Param name="mask" val="" valType="str" updates="constant"/>
        <Param name="ori" val="0" valType="num" updates="constant"/>
        <Param name="opacity" val="1" valType="num" updates="constant"/>
        <Param name="startType" val="time (s)" valType="str" updates="constant"/>
        <Param name="startVal" val="0.0" valType="code" updates="constant"/>
        <Param name="stopType" val="duration (s)" valType="str" updates="constant"/>
        <Param name="stopVal" val="4.0" valType="code" updates="constant"/>
        <Param name="saveStartStop" val="True" valType="bool" updates="None"/>
