    <Routine name="rating">
      <RoutineSettingsComponent name="rating" plugin="None">
        <Param name="name" val="rating" valType="code" updates="None"/>
        <Param name="color" val="black" valType="color" updates="None"/>
        <Param name="colorSpace" val="rgb" valType="str" updates="None"/>
        <Param name="saveStartStop" val="True" valType="bool" updates="None"/>
