        <Param name="disabled" val="False" valType="bool" updates="None"/>
      </ImageComponent>
      <EyetrackerRecordComponent name="etRecord" plugin="None">
        <Param name="name" val="etRecord" valType="code" updates="None"/>
        <Param name="actionType" val="Start and Stop" valType="str" updates="constant"/>
        <Param name="startType" val="time (s)" valType="str" updates="constant"/>
        <Param name="startVal" val="0.0" valType="code" updates="constant"/>
        <Param name="stopType" val="duration (s)" valType="str" updates="constant"/>
        <Param name="stopVal" val="4.0" valType="code" updates="constant"/>
        <Param name="stopWithRoutine" val="True" valType="bool" updates="constant"/>
        <Param name="syncScreenRefresh" val="True" valType="bool" updates="constant"/>
        <Param name="saveStartStop" val="True" valType="bool" updates="None"/>
        <Param name="disabled" val="False" valType="bool" updates="None"/>
      </EyetrackerRecordComponent>
    </Routine>
