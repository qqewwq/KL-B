      </CodeComponent>
      <TextComponent name="szary_ekran" plugin="None">
        <Param name="name" val="szary_ekran" valType="code" updates="None"/>
        <Param name="text" val=" " valType="str" updates="constant"/>
        <Param name="color" val="white" valType="color" updates="constant"/>
        <Param name="colorSpace" val="rgb" valType="str" updates="constant"/>
        <Param name="pos" val="(0,0)" valType="list" updates="constant"/>
        <Param name="height" val="20" valType="num" updates="constant"/>
